---
import Layout from '../../layouts/Layout.astro';
import ListEditor from '../../components/ListEditor.tsx';

const API_BASE = import.meta.env.API_URL || 'http://localhost:3000';
const { id } = Astro.params;

const res = await fetch(`${API_BASE}/lists/${id}`);
if (!res.ok) {
  return Astro.redirect('/404');
}
const list = await res.json();

function esc(str) {
  if (!str) return '';
  return str.replace(/[︠︡]/g, '');
}
---

<Layout title={`${list.title} - mylib`} description={list.description || `A list by ${list.username}`} showPortal>
  <div class="list-header">
    <h2>{esc(list.title)}</h2>
    <p class="list-meta">
      by <a href={`/users/${list.username}`}>{esc(list.display_name) || list.username}</a>
      · {list.works.length} {list.works.length === 1 ? 'book' : 'books'}
    </p>
    <ListEditor
      listId={list.id}
      ownerUsername={list.username}
      initialTitle={list.title}
      initialDescription={list.description || ''}
      client:only="react"
    />
  </div>

  {list.description && (
    <section class="list-description">
      <p>{esc(list.description)}</p>
    </section>
  )}

  <section class="list-works">
    {list.works.length === 0 ? (
      <p class="empty">No books in this list yet</p>
    ) : (
      <div class="list-works-grid">
        {list.works.map(w => (
          <a href={`/works/${w.slug}`} class="list-work">
            {w.cover_id ? (
              <img
                src={`https://covers.openlibrary.org/b/id/${w.cover_id}-M.jpg`}
                alt=""
                width="80"
                height="120"
                class="list-work-cover"
                loading="lazy"
              />
            ) : (
              <div class="list-work-cover-placeholder" />
            )}
            <div class="list-work-info">
              <div class="list-work-title">{esc(w.title)}</div>
              {w.description && <div class="list-work-desc">{esc(w.description)}</div>}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .list-header { margin-bottom: 16px; }
  .list-header h2 { margin: 0 0 4px; }
  .list-meta {
    font-size: 14px;
    color: #8a8477;
  }
  .list-meta a {
    color: #5a5549;
    text-decoration: none;
  }
  .list-meta a:hover { color: #b8860b; }
  .list-description {
    margin-bottom: 20px;
    line-height: 1.6;
    color: #3a3530;
  }
  .list-works-grid {
    border: 1px solid #d9d4c8;
  }
  .list-work {
    display: flex;
    gap: 15px;
    padding: 15px;
    border-bottom: 1px solid #e8e4d9;
    background: #faf6ed;
    text-decoration: none;
    color: inherit;
    align-items: flex-start;
  }
  .list-work:last-child { border-bottom: none; }
  .list-work:hover { background: #f0ebdf; }
  .list-work-cover {
    width: 80px;
    height: 120px;
    object-fit: cover;
    flex-shrink: 0;
    background: #e8e4d9;
  }
  .list-work-cover-placeholder {
    width: 80px;
    height: 120px;
    flex-shrink: 0;
    background: #e8e4d9;
  }
  .list-work-info { flex: 1; min-width: 0; }
  .list-work-title {
    font-weight: 500;
    font-size: 1.1em;
    margin-bottom: 6px;
  }
  .list-work-desc {
    font-size: 13px;
    color: #5a5549;
    line-height: 1.4;
  }
  .empty {
    color: #8a8477;
    padding: 20px;
    text-align: center;
  }
  @media (max-width: 600px) {
    .list-work-cover, .list-work-cover-placeholder { width: 60px; height: 90px; }
  }
</style>
