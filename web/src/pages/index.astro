---
import Layout from '../layouts/Layout.astro';
import SearchBox from '../components/SearchBox.tsx';
import FollowingFeed from '../components/FollowingFeed.tsx';
import ReadingShelves from '../components/ReadingShelves.tsx';

const API_BASE = import.meta.env.API_URL || 'http://localhost:3000';

let popular = [];
let recentReviews = [];
let recentLists = [];
try {
  const [popRes, revRes, listRes] = await Promise.all([
    fetch(`${API_BASE}/discover/popular`),
    fetch(`${API_BASE}/discover/reviews`),
    fetch(`${API_BASE}/discover/lists`),
  ]);
  if (popRes.ok) popular = await popRes.json();
  if (revRes.ok) recentReviews = await revRes.json();
  if (listRes.ok) recentLists = await listRes.json();
} catch {}

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=3600');
---

<Layout title="mylib" description="Curate your own library" showPortal>
  <SearchBox client:only="react" />
  <FollowingFeed client:only="react" />
  <ReadingShelves client:only="react" />

  <div class="discover" id="discover">
    {popular.length > 0 && (
      <section class="discover-section">
        <h2>Popular Books</h2>
        <div class="popular-grid">
          {popular.map(w => (
            <a href={`/works/${w.slug}`} class="popular-book">
              {w.cover_id ? (
                <img
                  src={`https://covers.openlibrary.org/b/id/${w.cover_id}-M.jpg`}
                  alt=""
                  width="100"
                  height="150"
                  class="popular-cover"
                  loading="lazy"
                />
              ) : (
                <div class="popular-cover-placeholder" />
              )}
              <div class="popular-title">{w.title}</div>
              {w.rating_avg && (
                <div class="popular-rating">
                  <span class="popular-stars">{w.rating_avg.toFixed(1)}</span>
                  <span class="popular-count">({w.ratings_count.toLocaleString()})</span>
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    {recentReviews.length > 0 && (
      <section class="discover-section">
        <h2>Recent Reviews</h2>
        <div class="recent-reviews">
          {recentReviews.map(r => (
            <div class="recent-review">
              <div class="recent-review-header">
                <a href={`/users/${r.username}`} class="recent-review-author">
                  {r.display_name || r.username}
                </a>
                <span class="recent-review-action">reviewed</span>
                <a href={`/works/${r.work_slug}/${r.edition_slug}`} class="recent-review-book">
                  {r.edition_title}
                </a>
              </div>
              <div class="recent-review-rating">
                <span class="stars-display">
                  {[1,2,3,4,5].map(s => {
                    const fill = Math.min(1, Math.max(0, r.rating - (s - 1)));
                    return (
                      <span class="star-wrapper">
                        <span class="star">★</span>
                        <span class="star filled" style={`width: ${fill * 100}%`}>★</span>
                      </span>
                    );
                  })}
                </span>
              </div>
              {r.review_text && (
                <p class="recent-review-text">
                  {r.review_text.length > 200 ? r.review_text.slice(0, 200) + '...' : r.review_text}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {recentLists.length > 0 && (
      <section class="discover-section">
        <h2>Recent Lists</h2>
        <div class="recent-lists">
          {recentLists.map(l => (
            <a href={`/lists/${l.id}`} class="recent-list">
              <span class="recent-list-title">{l.title}</span>
              <span class="recent-list-meta">
                by {l.display_name || l.username} · {l.work_count} {l.work_count === 1 ? 'book' : 'books'}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  import { $user } from '../stores/user';

  function toggleDiscover() {
    const el = document.getElementById('discover');
    if (el) el.style.display = $user.get() ? 'none' : '';
  }

  $user.subscribe(toggleDiscover);
  document.addEventListener('astro:page-load', toggleDiscover);
</script>

<style>
  .discover-section {
    margin-top: 30px;
  }
  .popular-grid {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    padding-bottom: 10px;
  }
  .popular-book {
    flex-shrink: 0;
    width: 100px;
    text-decoration: none;
    color: inherit;
  }
  .popular-book:hover .popular-title { color: #5a5549; }
  .popular-cover {
    width: 100px;
    height: 150px;
    object-fit: cover;
    background: #e8e4d9;
    display: block;
  }
  .popular-cover-placeholder {
    width: 100px;
    height: 150px;
    background: #e8e4d9;
  }
  .popular-title {
    font-size: 13px;
    font-weight: 500;
    margin-top: 6px;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .popular-rating {
    font-size: 12px;
    margin-top: 2px;
  }
  .popular-stars {
    color: #b8860b;
    font-weight: 500;
  }
  .popular-count {
    color: #8a8477;
    margin-left: 2px;
  }
  .recent-reviews {
    border: 1px solid #d9d4c8;
  }
  .recent-review {
    padding: 12px 15px;
    border-bottom: 1px solid #e8e4d9;
    background: #faf6ed;
  }
  .recent-review:last-child { border-bottom: none; }
  .recent-review-header {
    font-size: 14px;
    line-height: 1.4;
  }
  .recent-review-author {
    font-weight: 500;
    color: #3a3530;
    text-decoration: none;
  }
  .recent-review-author:hover { color: #b8860b; }
  .recent-review-action { color: #8a8477; margin: 0 4px; }
  .recent-review-book {
    color: #3a3530;
    text-decoration: none;
    font-style: italic;
  }
  .recent-review-book:hover { color: #b8860b; }
  .recent-review-rating { margin-top: 4px; }
  .recent-review-text {
    font-size: 13px;
    color: #5a5549;
    margin-top: 4px;
    line-height: 1.4;
  }
  .recent-lists {
    border: 1px solid #d9d4c8;
  }
  .recent-list {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    border-bottom: 1px solid #e8e4d9;
    background: #faf6ed;
    text-decoration: none;
    color: inherit;
  }
  .recent-list:last-child { border-bottom: none; }
  .recent-list:hover { background: #f0ebdf; }
  .recent-list-title { font-weight: 500; }
  .recent-list-meta { font-size: 13px; color: #8a8477; }
  @media (max-width: 600px) {
    .popular-book { width: 80px; }
    .popular-cover, .popular-cover-placeholder { width: 80px; height: 120px; }
    .recent-list { flex-direction: column; align-items: flex-start; gap: 2px; }
  }
</style>
