---
import Layout from '../../layouts/Layout.astro';
import ProfileEditor from '../../components/ProfileEditor.tsx';
import FollowButton from '../../components/FollowButton.tsx';
import UserLists from '../../components/UserLists.tsx';

const API_BASE = import.meta.env.API_URL || 'http://localhost:3000';
const { username } = Astro.params;

const res = await fetch(`${API_BASE}/users/${username}`);
if (!res.ok) {
  return Astro.redirect('/404');
}
const profile = await res.json();

const memberSince = new Date(profile.created_at).toLocaleDateString(undefined, {
  year: 'numeric',
  month: 'long',
});

function esc(str) {
  if (!str) return '';
  return str.replace(/[︠︡]/g, '');
}
---

<Layout title={profile.display_name || profile.username} description={profile.bio?.slice(0, 200) || `${profile.username}'s profile`} showPortal>
  <div class="profile-header">
    <div class="profile-identity">
      <h2 class="profile-name">{esc(profile.display_name) || profile.username}</h2>
      {profile.display_name && <p class="profile-username">@{profile.username}</p>}
      <p class="profile-meta">Member since {memberSince}</p>
    </div>
    <div class="profile-actions">
      <FollowButton username={profile.username} client:only="react" />
      <ProfileEditor username={profile.username} client:only="react" />
    </div>
  </div>

  {profile.bio && (
    <section class="profile-bio">
      <p>{esc(profile.bio)}</p>
    </section>
  )}

  <section class="profile-stats">
    <div class="stat">
      <span class="stat-count">{profile.followers_count}</span>
      <span class="stat-label">Followers</span>
    </div>
    <div class="stat">
      <span class="stat-count">{profile.following_count}</span>
      <span class="stat-label">Following</span>
    </div>
    <div class="stat">
      <span class="stat-count">{profile.reading_stats.finished}</span>
      <span class="stat-label">Finished</span>
    </div>
    <div class="stat">
      <span class="stat-count">{profile.reading_stats.reading}</span>
      <span class="stat-label">Reading</span>
    </div>
    <div class="stat">
      <span class="stat-count">{profile.reading_stats.want_to_read}</span>
      <span class="stat-label">Want to Read</span>
    </div>
  </section>

  <UserLists username={profile.username} initialLists={profile.lists} client:only="react" />

  {profile.reviews.length > 0 && (
    <section class="profile-reviews">
      <h2>Reviews ({profile.reviews.length})</h2>
      {profile.reviews.map(r => (
        <div class="review-item">
          <div class="review-header">
            <span class="stars-display">
              {[1,2,3,4,5].map(s => {
                const fill = Math.min(1, Math.max(0, r.rating - (s - 1)));
                return (
                  <span class="star-wrapper">
                    <span class="star">★</span>
                    <span class="star filled" style={`width: ${fill * 100}%`}>★</span>
                  </span>
                );
              })}
            </span>
            <a href={`/works/${r.work_slug}/${r.edition_slug}`} class="review-edition">{esc(r.edition_title)}</a>
            <span class="review-date">
              {new Date(r.updated_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </div>
          {r.review_text && <p class="review-body">{esc(r.review_text)}</p>}
        </div>
      ))}
    </section>
  )}
</Layout>

<style>
  .profile-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
  }
  .profile-name {
    font-size: 1.5em;
    margin: 0;
  }
  .profile-username {
    font-size: 14px;
    color: #8a8477;
    margin: 4px 0 0;
  }
  .profile-meta {
    font-size: 13px;
    color: #a9a49a;
    margin: 4px 0 0;
  }
  .profile-bio {
    margin-bottom: 20px;
    line-height: 1.6;
    color: #3a3530;
  }
  .profile-stats {
    display: flex;
    gap: 24px;
    margin-bottom: 30px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-count {
    font-size: 1.4em;
    font-weight: 500;
    color: #3a3530;
  }
  .stat-label {
    font-size: 13px;
    color: #8a8477;
    margin-top: 2px;
  }
  .profile-reviews { margin-bottom: 30px; }
  @media (max-width: 600px) {
    .profile-header { flex-direction: column; }
    .profile-stats { justify-content: center; }
  }
</style>
