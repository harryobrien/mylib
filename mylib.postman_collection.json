    {
      "name": "Reviews (CRUD)",
      "item": [
        {
          "name": "Re-add Edition for Review",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/editions/{{edition_slug}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"finished\"\n}"
            }
          }
        },
        {
          "name": "Create Review",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/editions/{{edition_slug}}/review",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4.25,\n  \"review_text\": \"A brilliant read, thoroughly enjoyed it.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Review created with quarter-star rating', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.success).to.be.true;",
                  "    pm.expect(data.rating).to.equal(4.25);",
                  "});"
                ]
              }
            }
          ]
        },
        {
