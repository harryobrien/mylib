{
  "info": {
    "name": "mylib API",
    "description": "Full test collection for the mylib REST API. Set the `base_url` variable to your API host (default: http://localhost:3000).\n\nRun the Auth > Register or Auth > Login request first, it automatically saves the JWT token for all subsequent authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "test_username",
      "value": "testuser"
    },
    {
      "key": "test_email",
      "value": "test@example.com"
    },
    {
      "key": "test_password",
      "value": "password123"
    },
    {
      "key": "work_slug",
      "value": ""
    },
    {
      "key": "edition_slug",
      "value": ""
    },
    {
      "key": "author_slug",
      "value": ""
    },
    {
      "key": "list_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.equal('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"username\": \"{{test_username}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Registration successful', function () {",
                  "    pm.expect(data.success).to.be.true;",
                  "    pm.expect(data.token).to.be.a('string');",
                  "});",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Login successful', function () {",
                  "    pm.expect(data.success).to.be.true;",
                  "    pm.expect(data.token).to.be.a('string');",
                  "});",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login rejected with 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Duplicate Email",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"username\": \"duplicate_test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate email rejected with 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Weak Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak@example.com\",\n  \"password\": \"short\",\n  \"username\": \"weaktest\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Weak password rejected with 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Unified Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search?q=african",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Search returns results', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.query).to.equal('african');",
                  "    pm.expect(data).to.have.property('works');",
                  "    pm.expect(data).to.have.property('authors');",
                  "    pm.expect(data).to.have.property('editions');",
                  "});",
                  "if (data.works && data.works.length > 0) {",
                  "    pm.collectionVariables.set('work_slug', data.works[0].slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Works",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search/works?q=african",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Work search returns results', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data).to.have.property('results');",
                  "    pm.expect(data).to.have.property('count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Authors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search/authors?q=forester",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Author search returns results', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data).to.have.property('results');",
                  "});",
                  "if (data.results && data.results.length > 0) {",
                  "    pm.collectionVariables.set('author_slug', data.results[0].slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Editions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search/editions?q=african",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Edition search returns results', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data).to.have.property('results');",
                  "});",
                  "if (data.results && data.results.length > 0) {",
                  "    pm.collectionVariables.set('edition_slug', data.results[0].slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search - Empty Query",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search?q=",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Empty search returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Works",
